# Optional frontend build-time ICE configuration for WebRTC.
# ICE URLs are public in the built app; never put long-lived TURN credentials here.
# Use short-lived TURN credentials when your provider supports them.
# VITE_RTC_ICE_SERVERS=[{"urls":"stun:your-stun-server:3478"},{"urls":"turn:your-turn-server:3478","username":"temporary-user","credential":"temporary-password"}]

# The Docker image sets NODE_ENV, HOST, and PORT for production.
# Set these when running the server directly.
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=3001
# TRUST_PROXY=1
